# Sample Nginx Configuration for CliniLink SPA
server {
    listen 80;
    server_name clinilinkhealth.com www.clinilinkhealth.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name clinilinkhealth.com www.clinilinkhealth.com;

    root /var/www/clinilink/dist;
    index index.html;

    # SSL configuration (add your certs here)
    # ssl_certificate /path/to/cert.pem;
    # ssl_certificate_key /path/to/key.pem;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # Static Assets Caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, no-transform, immutable";
    }

    # HTML - Never cache
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # SPA Routing: checks for physical file, directory, or falls back to /index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 404 Fallback
    error_page 404 /index.html;
}
